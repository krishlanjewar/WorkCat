<Window x:Class="WorkCat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WorkCat &amp; Eagle Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Storyboard for Cat Paw Swipe -->
        <Storyboard x:Key="PawSwipeStoryboard">
            <DoubleAnimation Storyboard.TargetName="StrikingPawTransform"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="-55" Duration="0:0:0.08" AutoReverse="True" RepeatBehavior="2x" />
            <DoubleAnimation Storyboard.TargetName="SlashEffect"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.06" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="SlashEffectTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.4" To="1.2" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="SlashEffectTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.4" To="1.2" Duration="0:0:0.12" />
        </Storyboard>
    </Window.Resources>

    <Canvas x:Name="OverlayCanvas" Background="{x:Null}">

        <!-- Floating Target / Status Bubble -->
        <Border x:Name="StatusBubble"
                Canvas.Left="0" Canvas.Top="0"
                Background="#EE232127"
                CornerRadius="12"
                Padding="10,4,10,4"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusEmoji" Text="⚡ " FontSize="12" Foreground="#FFE66D"/>
                <TextBlock x:Name="StatusText" Text="DRIFT DETECTED" FontSize="11" FontWeight="Bold" Foreground="#FFF6F3E7" FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 1. CHIBI WORKCAT CONTAINER                                -->
        <!-- ========================================================= -->
        <Canvas x:Name="CatRoot"
                Width="130" Height="100"
                Canvas.Left="200" Canvas.Top="500"
                Cursor="Hand"
                MouseLeftButtonDown="CatRoot_MouseLeftButtonDown"
                MouseMove="CatRoot_MouseMove"
                MouseLeftButtonUp="CatRoot_MouseLeftButtonUp">

            <Canvas.ContextMenu>
                <ContextMenu Background="#232127" Foreground="#F6F3E7" BorderBrush="#3A3840" Padding="4">
                    <MenuItem Header="🦅 Switch to Eagle Pet" Click="MenuSwitchPet_Click" Foreground="#FFE66D" FontWeight="Bold"/>
                    <MenuItem Header="🐾 Toggle Cat Style (Vector / Sprite)" Click="MenuToggleCatStyle_Click" Foreground="#F6F3E7"/>
                    <MenuItem Header="⚡ Test Claw Swipe (Close Tab)" Click="MenuTestStrike_Click" Foreground="#FFE66D"/>
                    <MenuItem Header="⏸️ Pause Detection (5 mins)" Click="MenuPauseDetection_Click" Foreground="#DDD"/>
                    <Separator Background="#3A3840"/>
                    <MenuItem x:Name="MenuCatStartup" Header="🚀 Run at Windows Startup" IsCheckable="True" Click="MenuStartup_Click" Foreground="#FFF"/>
                    <Separator Background="#3A3840"/>
                    <MenuItem Header="❌ Exit" Click="MenuExit_Click" Foreground="#FF8888"/>
                </ContextMenu>
            </Canvas.ContextMenu>

            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CatScaleTransform" CenterX="65" CenterY="50" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="CatRotateTransform" CenterX="65" CenterY="50" Angle="0" />
                    <TranslateTransform x:Name="CatTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Cat Ground Shadow -->
            <Ellipse x:Name="CatShadow"
                     Width="85" Height="14"
                     Canvas.Left="22" Canvas.Top="80"
                     Fill="#1A000000"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="CatShadowScaleTransform" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Cat Sprite Frame Image -->
            <Image x:Name="CatSpriteFrameImage"
                   Width="120" Height="90"
                   Canvas.Left="5" Canvas.Top="0"
                   Visibility="Collapsed"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Cat Procedural Vector Layer (WorkCat Chibi Loaf Style) -->
            <Canvas x:Name="CatVectorContainer" Width="130" Height="100" Visibility="Visible">
                <!-- Tail -->
                <Path x:Name="CatTail" Canvas.Left="10" Canvas.Top="24"
                      Data="M 18,36 C 6,32 0,16 6,6 C 11,0 19,2 18,9 C 18,18 24,28 32,32 Z"
                      Fill="#F6F3E7" RenderTransformOrigin="0.85, 0.95">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="TailRotateTransform" Angle="0" />
                    </Path.RenderTransform>
                </Path>

                <!-- Back Legs -->
                <Path x:Name="LegBackLeft" Canvas.Left="34" Canvas.Top="62"
                      Data="M 0,0 C 2,12 2,18 8,18 C 14,18 14,12 12,0 Z" Fill="#E9E5D4" RenderTransformOrigin="0.5, 0">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LegBackLeftRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>

                <Path x:Name="LegFrontLeft" Canvas.Left="78" Canvas.Top="62"
                      Data="M 0,0 C 2,12 2,18 8,18 C 14,18 14,12 12,0 Z" Fill="#E9E5D4" RenderTransformOrigin="0.5, 0">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LegFrontLeftRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>

                <!-- Main Chibi Loaf Body -->
                <Path x:Name="CatBody" Canvas.Left="18" Canvas.Top="14"
                      Data="M 22,25 
                            C 10,25 4,38 6,52 
                            C 8,66 18,70 35,70 
                            C 54,70 70,70 84,70 
                            C 96,70 105,62 105,48 
                            C 105,35 96,20 84,13 
                            C 81,9 76,0 70,2 
                            C 65,4 62,12 59,15 
                            C 51,14 45,14 39,16 
                            C 35,10 31,1 25,3 
                            C 21,5 21,18 22,25 Z"
                      Fill="#F6F3E7">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.08" Direction="270"/>
                    </Path.Effect>
                </Path>

                <!-- Fore Legs -->
                <Path x:Name="LegBackRight" Canvas.Left="46" Canvas.Top="62"
                      Data="M 0,0 C 2,12 2,18 8,18 C 14,18 14,12 12,0 Z" Fill="#F6F3E7" RenderTransformOrigin="0.5, 0">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="LegBackRightRotate" Angle="0" />
                    </Path.RenderTransform>
                </Path>

                <Canvas x:Name="StrikingPawCanvas" Canvas.Left="90" Canvas.Top="60" Width="18" Height="24" RenderTransformOrigin="0.3, 0.1">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="StrikingPawTransform" Angle="0" />
                    </Canvas.RenderTransform>
                    <Path Data="M 0,0 C 2,14 4,20 10,20 C 16,20 16,14 14,0 Z" Fill="#F6F3E7" />
                </Canvas>

                <!-- Face (Dark charcoal dot eyes & 'ω' mouth) -->
                <Canvas Canvas.Left="76" Canvas.Top="30" Width="36" Height="24">
                    <Ellipse Canvas.Left="6" Canvas.Top="6" Width="4.8" Height="5.6" Fill="#232127" />
                    <Ellipse Canvas.Left="22" Canvas.Top="6" Width="4.8" Height="5.6" Fill="#232127" />
                    <Path Canvas.Left="10" Canvas.Top="12" Data="M 0,0 Q 3,3.5 6,0.5 Q 9,3.5 12,0" Stroke="#232127" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Canvas>

            <!-- Swipe Slash Particle Effect -->
            <Path x:Name="SlashEffect" Canvas.Left="95" Canvas.Top="35"
                  Data="M 0,0 C 15,-10 25,5 30,25 C 20,18 10,12 0,0 Z" Fill="#FFFFE680" Opacity="0" RenderTransformOrigin="0.5, 0.5">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SlashEffectTransform" ScaleX="1" ScaleY="1" />
                        <RotateTransform Angle="-20" />
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- ========================================================= -->
        <!-- 2. DESKTOP EAGLE PET CONTAINER                            -->
        <!-- ========================================================= -->
        <Canvas x:Name="EagleRoot"
                Width="140" Height="140"
                Canvas.Left="500" Canvas.Top="500"
                Cursor="Hand"
                Visibility="Collapsed"
                MouseLeftButtonDown="EagleRoot_MouseLeftButtonDown"
                MouseMove="EagleRoot_MouseMove"
                MouseLeftButtonUp="EagleRoot_MouseLeftButtonUp">

            <Canvas.ContextMenu>
                <ContextMenu Background="#232127" Foreground="#F6F3E7" BorderBrush="#3A3840" Padding="4">
                    <MenuItem Header="🐱 Switch to Cat Pet" Click="MenuSwitchPet_Click" Foreground="#FFE66D" FontWeight="Bold"/>
                    <MenuItem Header="🦅 Command: Take Flight" Click="MenuEagleFly_Click" Foreground="#F6F3E7"/>
                    <MenuItem Header="🪵 Command: Perch &amp; Rest" Click="MenuEaglePerch_Click" Foreground="#F6F3E7"/>
                    <MenuItem Header="⚡ Test Raptor Dive Strike" Click="MenuTestStrike_Click" Foreground="#FFE66D"/>
                    <MenuItem Header="⏸️ Pause Detection (5 mins)" Click="MenuPauseDetection_Click" Foreground="#DDD"/>
                    <Separator Background="#3A3840"/>
                    <MenuItem Header="❌ Exit" Click="MenuExit_Click" Foreground="#FF8888"/>
                </ContextMenu>
            </Canvas.ContextMenu>

            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="EagleScaleTransform" CenterX="70" CenterY="70" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="EagleRotateTransform" CenterX="70" CenterY="70" Angle="0" />
                    <TranslateTransform x:Name="EagleTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Eagle Dynamic Ground / Flight Shadow -->
            <Ellipse x:Name="EagleShadow"
                     Width="90" Height="16"
                     Canvas.Left="25" Canvas.Top="115"
                     Fill="#20000000"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="EagleShadowScaleTransform" ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Eagle Sprite Frame Renderer -->
            <Image x:Name="EagleSpriteImage"
                   Width="140" Height="140"
                   Canvas.Left="0" Canvas.Top="0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

        </Canvas>

    </Canvas>
</Window>
